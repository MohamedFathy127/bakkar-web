{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakkar-inventory-test-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakkar-inventory-test",
      "database_id": "b9b6ed22-bc08-4cf1-998c-11dd8bc6a6e1",
      "migrations_dir": "../migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://bakkar-web.pages.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
