{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bakkar-inventory-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakkar-inventory",
      "database_id": "7b6198d0-7a6b-4c39-9caf-370112c95d23"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://bakkar-web.pages.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
